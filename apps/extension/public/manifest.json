{
  "manifest_version": 3,
  "name": "Media Ops — Tự đăng bài",
  "short_name": "Media Ops",
  "version": "0.1.0",
  "description": "Tự đăng bài đã lên lịch lên Facebook Page, TikTok, YouTube bằng tài khoản đang đăng nhập trên trình duyệt này.",
  "minimum_chrome_version": "116",
  "action": {
    "default_title": "Media Ops — Tự đăng bài",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "alarms",
    "tabs",
    "scripting",
    "notifications"
  ],
  "host_permissions": [
    "https://*.facebook.com/*",
    "https://business.facebook.com/*",
    "https://www.tiktok.com/*",
    "https://studio.youtube.com/*",
    "https://www.youtube.com/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
